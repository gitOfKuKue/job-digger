meta {
  name: Start Google OAuth
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/google
  body: none
  auth: inherit
}

settings {
  followRedirects: true
  maxRedirects: 5
}

docs {
  GET /auth/google
  Starts Google OAuth (gmail.send). Open this URL in a browser:
  http://localhost:8080/auth/google

  Callback: GET /auth/google/callback (handled by Google + Nest, then redirects to the web app).
}
